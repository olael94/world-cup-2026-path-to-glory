# ── Backend env vars (set these in Railway) ──────────────────────────────────

# OpenAI API key for AI-powered team intelligence
OPENAI_API_KEY=sk-...

# PostgreSQL connection string
# Railway auto-fills this when you link a Postgres service to the backend service.
DATABASE_URL=postgresql://path:glory@localhost:5432/path_to_glory

# Comma-separated list of frontend origins allowed to call the API.
# Add your Vercel deployment URL here once you have it.
# Example: http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── Frontend env vars (set these in Vercel) ───────────────────────────────────

# Public URL of the Railway backend service.
# Must be set in Vercel project settings under Environment Variables.
# Falls back to localhost:8000 when running locally.
NEXT_PUBLIC_API_BASE_URL=https://your-backend.railway.app
